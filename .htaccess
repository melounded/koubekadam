RewriteEngine On

# www → non-www (opravená doména)
RewriteCond %{HTTP_HOST} ^www\.koubekadam\.cz$ [NC]
RewriteRule ^(.*)$ https://koubekadam.cz/$1 [L,R=301]

# index.html → /
RewriteRule ^index\.html$ / [R=301,L]

# /kontakt → kontakt.html (pokud existuje)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.html$
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# --- /posts/slug → posts/slug.html (pokud existuje) ---
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.html$
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^posts/([^/]+)/?$ posts/$1.html [L]

# Blokace přímého přístupu k .html souborům (kromě 404.html)
RewriteCond %{THE_REQUEST} \s/+(.*)\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/404\.html$
RewriteRule ^(.*)\.html$ /$1? [R=301,L]